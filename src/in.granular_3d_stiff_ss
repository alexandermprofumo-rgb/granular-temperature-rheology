# in.granular_3d_stiff_ss : the STIFFNESS lever in 3D.
#
# WHY THIS EXISTS. Constraint 8 -- "no microstructural variable is a state
# function for n" -- has two halves. The STRUCTURAL half is already
# dimension-independent: mu = 3A_c + 3A_n + mu_t exactly, the channels reorder
# with friction, and eleven master-curve collapse tests reject in BOTH
# dimensions. The EMPIRICAL half is not: chi, the last surviving candidate, is
# falsified by a stiffness lever that exists only in 2D.
#
# Three stiffnesses spanning 100x is enough for that test -- what matters is the
# lever arm, not the number of points.
#
# dt scales as E^(-2/5) (Hertzian contact time), and step counts are supplied by
# the run script as strain/(gdot*dt) so every arm reaches the same STRAIN.

variable datafile index data.granular3d
variable mu_g     index 0.0
variable gdot     index 1.0e-3
variable Tgran    index 0.01
variable Pconf    index 2.0
variable seed     index 12345
variable label    index test3d
variable Emod     index 1.0e5
variable dt       index 0.001
variable nequil   index 1000000
variable nmeas    index 1000000
variable cdump_every index 25000

units           lj
dimension       3
atom_style      sphere
boundary        p p p
newton          off

read_data       ${datafile}

pair_style      granular
pair_coeff      * * hertz/material ${Emod} 0.3 0.5 tangential mindlin NULL 1.0 ${mu_g} damping tsuji

neighbor        0.3 bin
neigh_modify    every 1 delay 0 check yes
comm_modify     vel yes

# initial relaxation: settle overlaps, no shear
fix             integrate all nve/sphere
fix             damp all viscous 1.0
timestep        ${dt}
thermo          500
thermo_style    custom step ke
run             3000
unfix           damp
unfix           integrate
velocity        all set 0.0 0.0 0.0
reset_timestep  0

# Lees-Edwards simple shear: flow in x, gradient in y, vorticity in z
change_box      all triclinic
fix             shear all deform 1 xy erate ${gdot} remap v units box

compute         tbias all temp/deform

fix             therm all langevin ${Tgran} ${Tgran} 0.5 ${seed} zero yes
fix_modify      therm temp tbias

compute         press all pressure tbias

# ---- constant-pressure ensemble: barostat only the y box length (gradient
# direction), decoupled from the imposed xy shear and z (vorticity)
fix             baro all nph/sphere y ${Pconf} ${Pconf} 1.0 ptemp ${Tgran}

variable        P      equal (c_press[1]+c_press[2]+c_press[3])/3.0
variable        tau    equal c_press[4]
variable        muI    equal abs(v_tau)/v_P
variable        Theta  equal c_tbias
variable        rmean  equal 0.5
variable        Iiner  equal ${gdot}*2.0*v_rmean/sqrt(v_P)

# ---- per-contact geometry dump (now includes dz) for the 3D fabric tensor
compute         cid all property/local patom1 patom2
compute         cpl all pair/local dist dx dy dz fx fy fz p1 p2 p3 p4
dump            contacts all local ${cdump_every} dump.contacts.${label} &
                index c_cid[1] c_cid[2] c_cpl[1] c_cpl[2] c_cpl[3] c_cpl[4] &
                c_cpl[5] c_cpl[6] c_cpl[7] c_cpl[8] c_cpl[9] c_cpl[10] c_cpl[11]
dump_modify     contacts first no

compute         cont all contact/atom
compute         Zbulk all reduce ave c_cont
variable        Zc     equal c_Zbulk
thermo_style    custom step v_P v_tau v_muI c_tbias v_Theta v_Iiner v_Zc
thermo          1000

log             log.${label} append

run             ${nequil}

print           "=== BEGIN MEASUREMENT WINDOW ${label} ==="
run             ${nmeas}
print           "DONE label=${label} mu_g=${mu_g} gdot=${gdot} Tgran=${Tgran} seed=${seed} Z=$(c_Zbulk)"
