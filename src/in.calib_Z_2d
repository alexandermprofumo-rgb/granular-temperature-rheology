# 2D coordination calibration: Z(Pconf) at fixed mu_g.
#
# WHY: the 2D production sweep (Pconf=2) sits at Z=3.38, BELOW the 2D
# frictionless isostatic value of 4, i.e. hypostatic. The 3D sweep (Pconf=10)
# sits at Z=6.13, at/above its isostatic value of 6. Every cross-dimension
# comparison in the campaign -- including the framework "swap", where
# generalised isostaticity works in 3D and force-weighted fabric works in 2D
# -- is confounded by that.
#
# Because the runs barostat the y box length (fix nph/sphere y), steady-state
# density is set by Pconf, NOT by the phi handed to gen_data.py. So Pconf is
# the coordination knob, and the question is whether 2D at Pconf=10 reaches
# Z ~ 4. If it does, the 2D/3D coordination gap is a pressure artifact rather
# than a dimensional fact.
#
# This is a diagnostic only: short, no contact dump, prints Z and phi.
#
# Usage:
#   lmp -in in.calib_Z_2d -var datafile data.q -var mu_g 0.0 \
#       -var Pconf 10.0 -var Tgran 0.006 -var seed 1 -var label c_P10

variable datafile index data.granular
variable mu_g     index 0.0
variable gdot     index 1.0e-3
variable Tgran    index 0.006
variable Pconf    index 2.0
variable seed     index 12345
variable label    index calib
variable nequil   index 40000
variable nmeas    index 20000

units           lj
dimension       2
atom_style      sphere
boundary        p p p
newton          off

read_data       ${datafile}

pair_style      granular
pair_coeff      * * hertz/material 1.0e5 0.3 0.5 tangential mindlin NULL 1.0 ${mu_g} damping tsuji

neighbor        0.3 bin
neigh_modify    every 1 delay 0 check yes
comm_modify     vel yes

fix             integrate all nve/sphere
fix             damp all viscous 1.0
timestep        0.001
thermo          500
thermo_style    custom step ke
run             3000
unfix           damp
unfix           integrate
velocity        all set 0.0 0.0 0.0
reset_timestep  0

change_box      all triclinic
fix             shear all deform 1 xy erate ${gdot} remap v units box
compute         tbias all temp/deform
fix             therm all langevin ${Tgran} ${Tgran} 0.5 ${seed} zero yes
fix_modify      therm temp tbias
compute         press all pressure tbias
fix             baro all nph/sphere y ${Pconf} ${Pconf} 1.0 ptemp ${Tgran}
fix_modify      baro press press

# coordination number: contacts per particle, averaged over the box
compute         cont all contact/atom
compute         Zbulk all reduce ave c_cont

# area fraction: sum of disk areas over current (deforming) box area
compute         rad all property/atom radius
variable        ai   atom PI*c_rad*c_rad
compute         asum all reduce sum v_ai
variable        phi  equal c_asum/(lx*ly)

variable        P      equal (c_press[1]+c_press[2])/2.0
variable        tau    equal c_press[4]
variable        muI    equal abs(v_tau)/v_P
variable        Theta  equal c_tbias
variable        Zc     equal c_Zbulk

thermo_style    custom step v_P v_muI v_Theta v_Zc v_phi
thermo          1000
log             log.${label} append

run             ${nequil}
print           "=== BEGIN MEASUREMENT WINDOW ${label} ==="
run             ${nmeas}
print           "DONE label=${label} mu_g=${mu_g} Pconf=${Pconf} Z=$(c_Zbulk) phi=$(v_phi) P=$(v_P)"
