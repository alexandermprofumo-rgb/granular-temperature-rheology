# Raw simulation output.  The campaigns produce ~198 GB of per-run trajectory
# and per-contact dumps.  These are deliberately not tracked: they exceed what
# GitHub is for, and the figures rebuild from the derived tables in src/ plus
# the log archive on Zenodo.
sweep_*/
calib_Z/
verification_run/
audit2_scratch/
dump.*
log.lammps*
*.restart
data.granular*
prof.*

# Regenerated analysis tables.  analyze_ktgrid.py and build_master_table.py
# write here by default so a rerun does not overwrite the tracked tables.
derived/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# LaTeX build products
*.aux
*.bbl
*.blg
*.log
*.out
*.synctex.gz
*.fdb_latexmk
*.fls
*.toc
paper/main.pdf

# Editor swap, lock and autosave files
.#*
#*#
*~
*.swp

# OS
.DS_Store
Thumbs.db

# Manuscript source, added at submission.
paper/main.tex
